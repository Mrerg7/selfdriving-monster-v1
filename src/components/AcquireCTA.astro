---
import { SITE, mailtoAcquire } from '../lib/site';

interface Props {
  compact?: boolean;
  id?: string;
}

const { compact = false, id = 'acquire' } = Astro.props;
const mailto = mailtoAcquire();
---

<section
  id={id}
  class:list={[
    'cta-acquire relative overflow-hidden rounded-3xl border border-white/12',
    compact ? 'px-5 py-8 sm:px-8 sm:py-9' : 'px-6 py-10 sm:px-10 sm:py-12',
  ]}
  aria-labelledby={`${id}-heading`}
>
  <div
    class="pointer-events-none absolute -top-24 -right-16 h-56 w-56 rounded-full bg-signal/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-28 -left-10 h-64 w-64 rounded-full bg-ember/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative grid lg:grid-cols-[1.4fr_1fr] gap-8 lg:gap-12 items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">
        Premium domain · Available for acquisition
      </p>
      <h2 id={`${id}-heading`} class="mt-3 font-display text-3xl sm:text-4xl tracking-tighter">
        selfdriving<span class="text-ember">.monster</span>
      </h2>
      <p class="mt-4 max-w-xl text-sm sm:text-[15px] text-zinc-300 leading-relaxed">
        Category keyword + brandable TLD for Tesla autonomy, robotaxi media, FSD coverage, and mobility
        platforms. Own the phrase people already search.
      </p>
      {
        !compact && (
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs text-zinc-400">
            <li class="flex items-center gap-2">
              <span class="text-pulse" aria-hidden="true">●</span> Exact-match topical brand
            </li>
            <li class="flex items-center gap-2">
              <span class="text-pulse" aria-hidden="true">●</span> Live SEO foundation
            </li>
            <li class="flex items-center gap-2">
              <span class="text-pulse" aria-hidden="true">●</span> Direct sale · serious buyers
            </li>
          </ul>
        )
      }
    </div>

    <div class="rounded-2xl border border-white/10 bg-ink/55 p-5 sm:p-6 backdrop-blur-sm">
      <p class="text-xs uppercase tracking-[0.18em] text-zinc-500 mb-2">Acquisition desk</p>
      <a
        href={mailto}
        class="group inline-flex w-full min-h-12 items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3.5 text-ink font-semibold text-sm sm:text-base hover:bg-zinc-100 active:scale-[0.985] transition"
      >
        Contact {SITE.acquisitionEmail}
        <span class="transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
      <p class="mt-3 text-center text-xs text-zinc-500">
        Prefer email?
        <a class="text-zinc-300 underline underline-offset-2 hover:text-white" href={mailto}>
          {SITE.acquisitionEmail}
        </a>
      </p>
    </div>
  </div>
</section>
