---
import { mailtoAcquire } from '../lib/site';

const mailto = mailtoAcquire();
---

<div
  id="sticky-acquire"
  class="fixed inset-x-0 bottom-0 z-40 md:hidden pointer-events-none translate-y-full transition-transform duration-300"
  hidden
>
  <div class="pointer-events-auto border-t border-white/10 bg-ink/95 backdrop-blur-md px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
    <a
      href={mailto}
      class="flex min-h-12 w-full items-center justify-center gap-2 rounded-2xl bg-white text-ink font-semibold text-sm active:scale-[0.985]"
    >
      Acquire selfdriving.monster
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-acquire');
  if (bar) {
    const reveal = () => {
      const pastHero = window.scrollY > Math.min(window.innerHeight * 0.55, 480);
      bar.hidden = !pastHero;
      bar.classList.toggle('translate-y-full', !pastHero);
    };
    window.addEventListener('scroll', reveal, { passive: true });
    reveal();
  }
</script>
